# Bulk archive pulls — 200-300MB each, regenerable via fetch_history.py
tools/usc_*.csv
tools/wv_*.csv
tools/wv_spaces.json
*.sqlite
*.sqlite-journal

# Local runtime noise
tools/poll.log
tools/poll.err
tools/data/failures.log

__pycache__/
*.pyc
.DS_Store

# CI's snapshots are the committed dataset (tools/data/ci/).
# The laptop collector is local supplementary coverage — untracked, so pulls
# never conflict with the every-5-minute CI commits. patterns.py reads both.
tools/data/laptop/

# Superseded wide-area collection, kept locally in case the scope widens again
data_wide_backup/
tools/coverage.png
tools/.tilecache/
